# =============================================================================
# resume-ecosystem-node — Environment Configuration
# =============================================================================
# SECURITY WARNING: Never commit real secrets to version control!
# Copy this file to .env and replace placeholder values with secure secrets.
#
# To generate a secure JWT_SECRET, run one of these commands:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#   openssl rand -base64 64
#
# For production deployments, use a secrets manager (AWS Secrets Manager,
# HashiCorp Vault, etc.) or inject secrets via CI/CD pipeline.
# =============================================================================

# === Environment Mode ===
# Set to "production" in production deployments. This enables strict validation.
NODE_ENV=development

# === Database Configuration ===
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA_NAME
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/resume_db

# === Cache Configuration ===
# Redis connection URL for caching and rate limiting
REDIS_URL=redis://localhost:6379

# === Message Broker Configuration ===
# Kafka broker address for event-driven messaging
KAFKA_BROKER=localhost:9092

# === Authentication & Security ===
# CRITICAL: Replace this with a secure random string (minimum 32 characters)!
# The application will refuse to start in production with weak secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64

# JWT token expiration time (default: 2h)
JWT_EXPIRATION=2h

# === Service Ports ===
# Default port for services (each service overrides in its own config)
PORT=4000

# === Seed Data Configuration ===
# WARNING: These credentials are used ONLY for initial database seeding.
# In production, use strong passwords and change immediately after first login.
# The seed script will skip seeding if SEED_SKIP=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
SEED_ADMIN_NAME=Administrator
SEED_SKIP=false

# === Email/Notification Configuration (for notification-service) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# === OAuth Configuration (for integration-service) ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# === Observability (optional) ===
# Set to "true" to enable OpenTelemetry tracing
OTEL_ENABLED=false
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Prometheus metrics endpoint
METRICS_ENABLED=false

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASS=CHANGE_ME_app_password
SMTP_FROM=noreply@resumeecosystem.dev
WS_PORT=4061
